rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Auth and RBAC
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return request.auth.token.role != null 
        ? request.auth.token.role 
        : getUserData().role;
    }

    function isRescuerOrAdmin() {
      return isAuthenticated() && (getUserRole() == 'rescuer' || getUserRole() == 'admin');
    }

    function isGuide() {
      return isAuthenticated() && (getUserRole() == 'guide' || isRescuerOrAdmin());
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId) && request.resource.data.role in ['hiker', 'guide'];
      allow update: if isAuthenticated() && (isOwner(userId) || isRescuerOrAdmin());
      allow delete: if isRescuerOrAdmin();
    }

    // Telemetry Collection (Real-time hiker coordinates)
    match /telemetry/{telemetryId} {
      // Hikers can read telemetry of their own group; rescuers can read all
      allow read: if isAuthenticated();
      
      // Only the user themselves can record their own telemetry
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90.0 && request.resource.data.latitude <= 90.0
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180.0 && request.resource.data.longitude <= 180.0;
        
      allow update, delete: if isRescuerOrAdmin();
    }

    // Hiking Groups
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isGuide();
      allow update: if isAuthenticated() && (
        resource.data.guideId == request.auth.uid || 
        isRescuerOrAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) && resource.data.memberIds.hasAny([request.auth.uid]))
      );
      allow delete: if isGuide() && (resource.data.guideId == request.auth.uid || isRescuerOrAdmin());
    }

    // Routes
    match /routes/{routeId} {
      allow read: if isAuthenticated();
      allow create, update: if isGuide();
      allow delete: if isGuide() || isRescuerOrAdmin();
    }

    // Emergencies and SOS Operations
    match /emergencies/{emergencyId} {
      // Any authenticated user can read emergencies relevant to their group; rescuers see everything
      allow read: if isAuthenticated();
      
      // Any authenticated hiker can trigger an emergency / SOS beacon
      allow create: if isAuthenticated() 
        && request.resource.data.reporterId == request.auth.uid;
      
      // Rescuers can update status, assign rescue units, or update SAR polygons
      allow update: if isAuthenticated() && (
        isRescuerOrAdmin() || 
        resource.data.reporterId == request.auth.uid
      );
      
      allow delete: if isRescuerOrAdmin();
    }

    // SAR AI Audit Logs
    match /sar_audit_logs/{logId} {
      allow read: if isRescuerOrAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }
  }
}
