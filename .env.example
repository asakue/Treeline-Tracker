# =============================================================================
# Treeline Tracker - Environment Configuration
# =============================================================================

# Backend REST API & WebSocket Services (PostgreSQL / PostGIS & Mesh Core)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# Optional Storage Mode override: 'rest' (default) or 'local'
NEXT_PUBLIC_STORAGE_MODE=rest

# Google AI / Gemini API Key (Required for SAR Search Sector AI Inferences)
GEMINI_API_KEY=your-gemini-api-key

# Optional: Mapbox / Custom Tile Server Key (if using non-OSM layers)
NEXT_PUBLIC_MAPBOX_TOKEN=
