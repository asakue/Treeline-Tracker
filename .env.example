# =============================================================================
# Treeline Tracker - Environment Configuration
# =============================================================================

# Firebase Client Configuration (Cloud Firestore, Auth, Storage)
# Required for connecting to production / staging Firebase project
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=treeline-tracker.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=treeline-tracker
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=treeline-tracker.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Google AI / Gemini API Key (Required for SAR Search Sector AI Inferences)
# In Firebase App Hosting, this is provisioned via Google Secret Manager
GEMINI_API_KEY=your-gemini-api-key

# Optional: Mapbox / Custom Tile Server Key (if using non-OSM layers)
NEXT_PUBLIC_MAPBOX_TOKEN=
